{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable", "webworker"],
        "types": ["vite/client", "node", "@types/wicg-file-system-access"],
        "paths": {
            "!/*": ["./node_modules/*"]
        },
        "allowJs": true,
        "checkJs": false,
        "strict": false,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["**/*.ts", "*.ts", "**/*.js", "*.js"],
    "exclude": ["**/node_modules/*", "js/ffmpeg.test.ts", "js/platform-detection.test.ts", "js/HiFi.test.ts", "js/api.test.ts", "js/apple-music-api.test.js", "js/replay-gain.test.js", "js/tests/api-streaming-fallback.test.js", "js/tests/apple-video-cover-function.test.js", "js/tests/db.test.js", "js/tests/deezer-fallback.test.js", "js/tests/lyrics-ttml.test.js", "js/tests/music-api-tracks.test.js", "js/tests/music-api-video-artwork.test.js", "js/tests/proxy-utils.test.js", "js/tests/storage.test.js", "js/tests/tracks-api.test.js", "js/tests/utils.test.js"]
}
